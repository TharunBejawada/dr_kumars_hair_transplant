# ── DynamoDB tables / S3 bucket (names from the Amplify backend deploy) ──
APPOINTMENTS_TABLE=
ADMIN_USERS_TABLE=
BLOGS_TABLE=
S3_MEDIA_BUCKET=
APP_AWS_REGION=ap-south-1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin auth ──
# Random secret, min 32 chars:  openssl rand -base64 48
JWT_SECRET=
# One-time superadmin bootstrap: created on first login if it doesn't exist yet.
# Set in Amplify, sign in once, then REMOVE both variables.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Local development only (see scripts/local-db.mjs) ──
# DYNAMODB_ENDPOINT=http://localhost:4567
